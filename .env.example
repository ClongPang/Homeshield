# 家中盾配置(复制为 .env 后填写)
# 判定模式:mock=纯规则(无 API key 可跑全链路/CI);llm=调用下方供应商
MODE=mock

# ---- 供应商(任意命名,三件套:API_KEY / BASE_URL / MODEL,均为 OpenAI 兼容端点)----
# 示例:两个供应商分别承担对话与向量任务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ---- 任务分工:每个任务用哪个供应商 ----
# chat=判定/特征补抽/回复;transcribe=图片转写(需视觉模型,留空回落 chat);embed=向量检索(留空则纯关键词)
# CHAT_PROVIDER=deepseek
# TRANSCRIBE_PROVIDER=deepseek
# EMBED_PROVIDER=qwen

# ---- 微信公众号(测试号/服务号,D3 接入)----
WECHAT_TOKEN=
WECHAT_APPID=
WECHAT_SECRET=
# 单套联防提醒模板:thing1 摘要、phrase1 高危预警、thing2 被联防者称呼
WECHAT_MULTI_TEMPLATE_ID=

# 对外可达地址(模板消息中的控制台链接使用),如 https://shield.example.com
# 配置后首次有效消息处理完成时，经客服消息单独发送个人链接
PUBLIC_BASE_URL=

# 每用户活跃单向联防关系上限(进出合计)；邀请码有效期与纠正投票期限(天)
MAX_RELATIONS=10
INVITE_CODE_TTL_DAYS=7
CORRECTION_WINDOW_DAYS=7

# SQLite 路径(默认工作目录下)
DB_PATH=homeshield.db
INCIDENT_IDLE_SECONDS=21600
SUPPLY_WINDOW_SECONDS=604800
SUPPLY_MAX_ITEMS=10
