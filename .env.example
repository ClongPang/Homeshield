# 家中盾配置(复制为 .env 后填写)
# 判定模式:mock=纯规则(无 API key 可跑全链路/CI);llm=调用下方供应商
MODE=mock

# ---- 供应商(任意命名,三件套:API_KEY / BASE_URL / MODEL,均为 OpenAI 兼容端点)----
# 示例:两个供应商分别承担对话与向量任务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ---- 任务分工:每个任务用哪个供应商 ----
# chat=判定/特征补抽/回复;transcribe=图片转写(需视觉模型,留空回落 chat);embed=向量检索(留空则纯关键词)
# CHAT_PROVIDER=deepseek
# TRANSCRIBE_PROVIDER=deepseek
# EMBED_PROVIDER=qwen

# ---- 微信公众号(测试号/服务号,D3 接入)----
WECHAT_TOKEN=
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TEMPLATE_ID=

# 对外可达地址(模板消息中的控制台链接使用),如 https://shield.example.com
# 多租户部署必填:自助开通/绑定成功后经客服消息把个人链接发给家人
PUBLIC_BASE_URL=

# 多租户护栏:家庭总数上限 / 每家庭成员上限 / 绑定码有效期(天)
MAX_FAMILIES=100
MAX_MEMBERS=10
BIND_CODE_TTL_DAYS=7

# SQLite 路径(默认工作目录下)
DB_PATH=homeshield.db
