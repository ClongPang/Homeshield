# 家中盾配置(复制为 .env 后填写)
# 判定模式:mock=纯规则(无 API key 可跑全链路/CI);llm=调用下方供应商
MODE=mock

# ---- 供应商(任意命名,三件套:API_KEY / BASE_URL / MODEL,均为 OpenAI 兼容端点)----
# 示例:两个供应商分别承担对话与向量任务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ---- 任务分工:每个任务用哪个供应商 ----
# chat=判定/特征补抽/回复;transcribe=图片转写(需视觉模型,留空回落 chat);embed=向量检索(留空则纯关键词)
# CHAT_PROVIDER=deepseek
# TRANSCRIBE_PROVIDER=deepseek
# EMBED_PROVIDER=qwen

# 对外可达地址(企微欢迎语/个人链接/告警详情使用),如 https://shield.example.com
# 配置后首次有效消息处理完成时,经客服会话单独发送个人链接
PUBLIC_BASE_URL=

# 每用户活跃单向联防关系上限(进出合计)；邀请码有效期与纠正投票期限(天)
MAX_RELATIONS=10
INVITE_CODE_TTL_DAYS=7
CORRECTION_WINDOW_DAYS=7

# kbbuild 离线素材库 SQLite 路径(服务运行数据使用 Postgres)
DB_PATH=data/kb_build.db
# 必须替换为强随机口令,并与 DATABASE_URL 中的口令一致；不要提交真实 .env
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://homeshield:replace-with-a-strong-random-password@localhost:5432/homeshield
TEST_DATABASE_URL=postgresql://homeshield:replace-with-a-strong-random-password@localhost:5432/homeshield_test
# 压测专用:临时让 mock 判定等待 1 秒；常规运行保持 0
MOCK_JUDGE_DELAY_SECONDS=0
INCIDENT_IDLE_SECONDS=21600
SUPPLY_WINDOW_SECONDS=604800
SUPPLY_MAX_ITEMS=10

# ---- 企业微信(微信客服,家盾联防新通道)----
# corpid=团队信息页的企业ID;agent_id/secret=自建应用"家中盾"(需授权为微信客服可调用应用)
WECOM_CORPID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
# 微信客服自身密钥(可选,优先级高于应用密钥)
WECOM_KF_SECRET=
# 回调验签与加解密三件套:Token 任意字符串;AESKey 固定 43 位字母数字
WECOM_TOKEN=
WECOM_AES_KEY=

# ---- 推送通道自助开通(联防者告警经应用消息触达微信插件)----
# 通讯录同步助手密钥(可选,仅自助入录需要;未验证企业可用性以真机核验为准)
WECOM_CONTACT_SECRET=
# 手机号未命中时是否自助创建成员入录(通讯录写权限,默认关)
PUSH_SELF_ENROLL=false
# OAuth 绑定凭证有效期(秒),一次性防重放
PUSH_STATE_TTL=600
# 微信插件邀请二维码图片路径(企微后台「我的企业→微信插件」下载后放置)
WECOM_PLUGIN_QR_PATH=deploy/assets/wecom_plugin_qr.png
